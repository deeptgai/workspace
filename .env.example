# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Fill this after running:
# npm run dev -- login
TELEGRAM_SESSION=

# Telegram Bot API token from BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=deep_signals_bot
TELEGRAM_SESSION_SECRET=
TELEGRAM_LOGIN_DOMAIN=local.tgdeep.xyz
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PORT=8787
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_MINI_APP_URL=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
TELEGRAM_STARS_PER_USD=100
NEXT_PUBLIC_TELEGRAM_AUTH_DEBUG=0

# Import throttling defaults for future workers.
TELEGRAM_IMPORT_BATCH_SIZE=100
TELEGRAM_IMPORT_SLEEP_MS=3000
# Full imports are time-bounded by TELEGRAM_IMPORT_SINCE_DAYS; this is only a safety cap.
TELEGRAM_IMPORT_SINCE_DAYS=365
UI_UPDATE_IMPORT_LIMIT=200
UI_UPDATE_COMMENT_POST_LIMIT=80
UI_UPDATE_COMMENTS_PER_POST=100
UI_FULL_IMPORT_LIMIT=20000
UI_FULL_COMMENT_POST_LIMIT=100
UI_FULL_COMMENTS_PER_POST=100

# Future app settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deeptg
REDIS_URL=redis://localhost:6379
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
OPENROUTER_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Deep TG
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_RESPONSE_HEALING=true
AI_MODEL=anthropic/claude-sonnet-4.5
AI_REQUEST_TIMEOUT_MS=300000
AI_REQUEST_MAX_ATTEMPTS=3
SNAPSHOT_SECTION_WORKER_CONCURRENCY=4
SNAPSHOT_SECTION_AGENT_TIMEOUT_MS=600000
SNAPSHOT_SECTION_AGENT_MAX_ROUNDS=2
SNAPSHOT_SECTION_AGENT_MAX_SEARCHES=6
SNAPSHOT_SECTION_AGENT_MAX_SEARCHES_PER_ROUND=3
SNAPSHOT_SECTION_AGENT_RAG_LIMIT=10
SNAPSHOT_SECTION_AGENT_EVIDENCE_LIMIT=24
SNAPSHOT_RAG_CONTEXT_WINDOWS=8
SNAPSHOT_RAG_CONTEXT_BEFORE=4
SNAPSHOT_RAG_CONTEXT_AFTER=4
SNAPSHOT_SIGNAL_THREAD_EVIDENCE_LIMIT=12
SNAPSHOT_SIGNAL_THREAD_EVIDENCE_ROUNDS=4
SNAPSHOT_PEOPLE_CONTEXT_LIMIT=30

# OpenAI-compatible embeddings endpoint.
# If EMBEDDINGS_API_KEY is empty, OPENROUTER_API_KEY is used as a fallback.
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=intfloat/multilingual-e5-large
EMBEDDINGS_BATCH_SIZE=50

# fal.ai image generation for signal preview thumbnails.
FAL_KEY=
FAL_PREVIEW_MODEL=fal-ai/flux-1/schnell
FAL_PREVIEW_IMAGE_SIZE=landscape_4_3
FAL_PREVIEW_OUTPUT_FORMAT=jpeg
FAL_PREVIEW_EXPIRATION_SECONDS=604800

# S3-compatible object storage for generated preview images.
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.85
SEAWEEDFS_IP=localhost
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_S3_PUBLISHED_PORT=8333
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_BUCKET=deeptg-previews
OBJECT_STORAGE_PUBLIC_BASE_PATH=/media

SNAPSHOT_COVER_IMAGE_WORKER_CONCURRENCY=2
SIGNAL_PREVIEW_IMAGE_WORKER_CONCURRENCY=10
