generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id              String    @id @default(cuid())
  provider        String
  externalId      String
  type            String
  title           String
  username        String?
  url             String?
  audienceCount   Int?
  metadata        Json?
  paidSignalKinds String[]  @default([])
  accessPriceUsdCents Int   @default(1000)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastImportAt    DateTime?

  items        ContentItem[]
  snapshots    SourceSnapshot[]
  signals      SourceSignal[]
  importStates SourceImportState[]
  analysisState SourceAnalysisState?
  payments     Payment[]
  accessGrants SourceAccessGrant[]

  @@unique([provider, externalId])
  @@index([provider])
  @@index([type])
  @@index([username])
}

model SourceImportState {
  id               String    @id @default(cuid())
  sourceId         String
  provider         String
  scope            String    @default("content")
  oldestExternalId String?
  newestExternalId String?
  cursor           Json?
  metadata         Json?
  lastImportAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, scope])
  @@index([provider])
  @@index([scope])
}

model SourceAnalysisState {
  id                           String    @id @default(cuid())
  sourceId                     String    @unique
  provider                     String
  lastAnalyzedContentCreatedAt DateTime?
  lastAnalyzedPublishedAt      DateTime?
  lastAnalyzedExternalId       String?
  lastSnapshotId               String?
  cursor                       Json?
  metadata                     Json?
  completedAt                  DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([provider])
  @@index([lastAnalyzedContentCreatedAt])
  @@index([lastAnalyzedPublishedAt])
}

model Actor {
  id          String   @id @default(cuid())
  provider    String
  externalId  String
  username    String?
  displayName String?
  firstName   String?
  lastName    String?
  url         String?
  photo       String?
  isBot       Boolean?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ContentItem[]

  @@unique([provider, externalId])
  @@index([provider])
  @@index([username])
}

model TelegramUser {
  id           String   @id @default(cuid())
  customerId   String?
  telegramId   BigInt   @unique
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  rawJson      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer  Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  purchases TelegramPurchase[]

  @@index([customerId])
  @@index([username])
}

model Customer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  telegramUsers TelegramUser[]
  payments      Payment[]
  accessGrants  SourceAccessGrant[]
}

model Payment {
  id                 String    @id @default(cuid())
  customerId         String?
  provider           String
  providerPaymentId  String?
  providerCustomerId String?
  product            String
  sourceId           String?
  status             String    @default("pending")
  currency           String
  amount             Int
  paidAt             DateTime?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer          Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  source            Source?             @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  telegramPurchases TelegramPurchase[]
  accessGrants      SourceAccessGrant[]

  @@unique([provider, providerPaymentId])
  @@index([customerId])
  @@index([provider])
  @@index([sourceId])
  @@index([status])
}

model SourceAccessGrant {
  id         String    @id @default(cuid())
  customerId String
  sourceId   String
  scope      String    @default("source")
  status     String    @default("active")
  provider   String?
  product    String?
  paymentId  String?
  reason     String    @default("purchase")
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  source   Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([customerId, sourceId, scope, status])
  @@index([customerId])
  @@index([sourceId])
  @@index([status])
  @@index([provider])
  @@index([paymentId])
}

model TelegramPurchase {
  id                      String    @id @default(cuid())
  telegramUserId          String
  paymentId               String?
  telegramId              BigInt
  product                 String
  sourceId                String
  status                  String    @default("pending")
  currency                String    @default("XTR")
  amount                  Int
  invoicePayload          String    @unique
  telegramPaymentChargeId String?
  providerPaymentChargeId String?
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  telegramUser TelegramUser @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([telegramId, product, sourceId, status])
  @@index([telegramUserId])
  @@index([paymentId])
  @@index([telegramId])
  @@index([sourceId])
  @@index([status])
}

model ContentItem {
  id                String   @id @default(cuid())
  sourceId          String
  actorId           String?
  provider          String
  externalId        String
  kind              String   @default("post")
  parentId          String?
  title             String?
  text              String?
  url               String?
  publishedAt       DateTime
  replyToExternalId String?
  views             Int?
  forwards          Int?
  reactionsTotal    Int      @default(0)
  reactionCounts    Json?
  repliesCount      Int      @default(0)
  hasComments       Boolean  @default(false)
  commentsPeerId    String?
  engagementScore   Float    @default(0)
  metrics           Json?
  rawJson           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  source           Source                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  parent           ContentItem?             @relation("ContentThread", fields: [parentId], references: [id], onDelete: Cascade)
  children         ContentItem[]            @relation("ContentThread")
  actor            Actor?                   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  embeddings       ContentEmbedding[]
  formats          ContentItemFormat[]
  snapshotEvidence SnapshotSignalEvidence[]
  sourceEvidence   SourceSignalEvidence[]

  @@unique([provider, sourceId, externalId, kind])
  @@index([sourceId, publishedAt])
  @@index([sourceId, externalId])
  @@index([sourceId, kind])
  @@index([parentId])
  @@index([sourceId, engagementScore])
  @@index([actorId])
  @@index([provider])
}

model ContentItemFormat {
  id            String   @id @default(cuid())
  itemId        String
  model         String
  textHash      String
  formattedText String
  changed       Boolean  @default(false)
  confidence    Float?
  notes         Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, model])
  @@index([itemId])
  @@index([model])
}

model ContentEmbedding {
  id         String                @id @default(cuid())
  itemId     String
  model      String
  dimensions Int
  textHash   String
  embedding  Unsupported("vector")
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  item ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, model])
  @@index([model])
  @@index([itemId])
}

model SourceSnapshot {
  id          String    @id @default(cuid())
  sourceId    String
  kind        String
  title       String
  status      String    @default("pending")
  periodFrom  DateTime?
  periodTo    DateTime?
  summary     String?
  heroTheme   Json?
  coverImage  Json?
  pipeline    Json?
  document    Json?
  error       String?
  model       String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  source   Source                  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sections SourceSnapshotSection[]
  signals  SnapshotSignal[]

  @@index([sourceId, createdAt])
  @@index([sourceId, periodFrom, periodTo])
  @@index([kind])
  @@index([status])
}

model SourceSnapshotSection {
  id          String    @id @default(cuid())
  snapshotId  String
  sectionId   String
  title       String
  agent       String
  status      String    @default("pending")
  summary     String?
  items       Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  snapshot SourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, sectionId])
  @@index([snapshotId, status])
  @@index([sectionId])
  @@index([status])
}

model SnapshotSignal {
  id               String    @id @default(cuid())
  snapshotId       String
  sourceId         String
  externalSignalId String
  kind             String
  title            String
  summary          String
  canonicalClaim   String?
  fingerprint      String?
  tags             Json?
  priority         String?
  score            String?
  confidence       Float?
  metrics          Json?
  url              String?
  person           Json?
  previewImage     Json?
  timeline         Json?
  externalContext  Json?
  sortAt           DateTime?
  status           String    @default("pending")
  resolution       Json?
  sourceSignalId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  snapshot     SourceSnapshot           @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  sourceSignal SourceSignal?            @relation(fields: [sourceSignalId], references: [id], onDelete: SetNull)
  evidence     SnapshotSignalEvidence[]

  @@unique([snapshotId, externalSignalId])
  @@index([snapshotId, kind])
  @@index([snapshotId, status])
  @@index([sourceId, kind])
  @@index([sourceSignalId])
  @@index([sortAt])
}

model SnapshotSignalEvidence {
  id               String   @id @default(cuid())
  snapshotSignalId String
  contentItemId    String?
  itemExternalId   String
  quote            String?
  reason           String?
  position         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  snapshotSignal SnapshotSignal @relation(fields: [snapshotSignalId], references: [id], onDelete: Cascade)
  contentItem    ContentItem?   @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@unique([snapshotSignalId, itemExternalId])
  @@index([contentItemId])
  @@index([itemExternalId])
}

model SourceSignal {
  id              String    @id @default(cuid())
  sourceId        String
  kind            String
  title           String
  summary         String
  canonicalClaim  String
  fingerprint     String
  tags            Json?
  status          String    @default("active")
  score           Float     @default(0)
  confidence      Float?
  previewImage    Json?
  firstEvidenceAt DateTime?
  lastEvidenceAt  DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  source          Source                 @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  snapshotSignals SnapshotSignal[]
  evidence        SourceSignalEvidence[]

  @@unique([sourceId, kind, fingerprint])
  @@index([sourceId, kind])
  @@index([sourceId, status])
  @@index([lastEvidenceAt])
}

model SourceSignalEvidence {
  id                  String   @id @default(cuid())
  sourceSignalId      String
  contentItemId       String?
  snapshotSignalId    String?
  itemExternalId      String
  quote               String?
  reason              String?
  confidence          Float?
  firstSeenSnapshotId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sourceSignal SourceSignal @relation(fields: [sourceSignalId], references: [id], onDelete: Cascade)
  contentItem  ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@unique([sourceSignalId, itemExternalId])
  @@index([contentItemId])
  @@index([snapshotSignalId])
  @@index([itemExternalId])
}
